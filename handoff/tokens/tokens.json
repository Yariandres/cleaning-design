 "surface": {
  "--ui-bg": "neutral-50",
  "--ui-bg-muted": "neutral-100",
  "--ui-bg-elevated": "#FFFFFF",
  "--ui-bg-inverted": "neutral-900",
  "--ui-text": "neutral-700",
  "--ui-text-highlighted": "neutral-900",
  "--ui-text-muted": "neutral-500",
  "--ui-text-dimmed": "neutral-400 (disabled only)",
  "--ui-text-inverted": "#FFFFFF",
  "--ui-border": "neutral-200",
  "--ui-border-muted": "neutral-200",
  "--ui-border-accented": "neutral-300",
  "--ui-primary": "primary-500"
 },
 "field": {
  "border": "neutral-400",
  "focus-ring": "3px solid neutral-900, offset 3px (white on primary or ink surfaces)"
 },
 "type": {
  "display": {
   "family": "Bricolage Grotesque",
   "weights": "500-800 variable",
   "use": "h1-h3, big prices, wordmark"
  },
  "body": {
   "family": "Figtree",
   "weights": "400-700 variable",
   "use": "body, UI, labels, numbers (tabular-nums)"
  },
  "base-size": {
   "desktop": "17px",
   "mobile-390": "16px"
  },
  "line-height": {
   "body": 1.55,
   "display": 1.06
  },
  "eyebrow": "Figtree 700, 13px, uppercase, .08em, primary-600"
 },
 "radius": {
  "--ui-radius": "0.375rem",
  "lg": "12px",
  "xl": "18px",
  "2xl": "24px",
  "buttons": "full pill"
 },
 "spacing": "4px grid (Tailwind default)",
 "container": "70rem",
 "breakpoints": {
  "sm": 640,
  "md": 768,
  "lg": 1024,
  "xl": 1280,
  "2xl": 1536
 },
 "tap-target-min": "44px",
 "motion": {
  "duration": "150-250ms (hover 200ms, image zoom 350ms)",
  "easing": "ease / ease-out",
  "properties": "opacity, transform only",
  "reduced-motion": "no transforms, no transitions"
 },
 "service-accents": {
  "stroller": "secondary",
  "sofa": "primary",
  "car": "primary-800",
  "pets": "neutral-700",
  "mattress": "primary-600"
 }
}